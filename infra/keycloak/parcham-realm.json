{
  "realm": "parcham",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "CANDIDATE" },
      { "name": "INSTRUCTOR" },
      { "name": "ACADEMY_ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "parcham-web",
      "name": "Parcham Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-parcham-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "parcham-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "parcham-api",
      "name": "Parcham API",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "candidate",
      "enabled": true,
      "firstName": "Candidate",
      "lastName": "Demo",
      "credentials": [
        { "type": "password", "value": "candidate", "temporary": false }
      ],
      "realmRoles": ["CANDIDATE"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "instructor",
      "enabled": true,
      "firstName": "Instructor",
      "lastName": "Demo",
      "credentials": [
        { "type": "password", "value": "instructor", "temporary": false }
      ],
      "realmRoles": ["INSTRUCTOR"]
    }
  ]
}
