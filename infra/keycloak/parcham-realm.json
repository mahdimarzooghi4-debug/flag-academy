{
  "realm": "parcham",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "CANDIDATE"
      },
      {
        "name": "INSTRUCTOR"
      },
      {
        "name": "ACADEMY_ADMIN"
      },
      {
        "name": "ASSESSOR"
      }
    ]
  },
  "clients": [
    {
      "clientId": "parcham-web",
      "name": "Parcham Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://parcham-academy-stage.onrender.com/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://parcham-academy-stage.onrender.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-parcham-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "parcham-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "parcham-api",
      "name": "Parcham API",
      "enabled": true,
      "bearerOnly": true
    }
  ],
